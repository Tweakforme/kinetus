# Copy to .env (git-ignored) and fill in real values. Never commit real values.

# PostgreSQL connection string used by Prisma. Format only — no real credentials here.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Public origin of the site (no trailing slash). Used for canonical URLs, sitemap,
# robots and site-level JSON-LD. Production domain to be confirmed with AJ/Mike.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
