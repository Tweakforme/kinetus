# Copy to .env (git-ignored) and fill in real values. Never commit real values.

# PostgreSQL connection strings used by Prisma. Format only: no real credentials here.
# DATABASE_URL is the pooled connection the app uses; DIRECT_URL is the direct connection
# migrations use.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Public origin of the site (no trailing slash). Used for canonical URLs, sitemap,
# robots and site-level JSON-LD. Production domain to be confirmed with AJ/Mike.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Vercel Blob read-write token (set automatically when the Blob store is connected to the
# Vercel project). Admin image uploads are stored there.
BLOB_READ_WRITE_TOKEN=""

# Signs admin session cookies. 32+ random characters; use a different value per
# environment. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=""
